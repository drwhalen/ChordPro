<Project Sdk="Microsoft.NET.Sdk">

  <!-- The song drawing shared by the Mac app (ChordPro.Viewer) and the iPad/iPhone app (ChordPro.Mobile). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The iOS app is trimmed: this flags anything here that trimming would break. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChordPro.Core\ChordPro.Core.csproj" />
  </ItemGroup>

</Project>
