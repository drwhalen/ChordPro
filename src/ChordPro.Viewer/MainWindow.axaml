<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:ChordPro.Core"
        xmlns:local="using:ChordPro.Viewer"
        x:Class="ChordPro.Viewer.MainWindow"
        Title="ChordPro Viewer"
        Icon="/Assets/AppIcon.png"
        Width="1100" Height="900"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <Style Selector="WrapPanel.toolbar > StackPanel">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="WrapPanel.toolbar > StackPanel > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A thin line between the toolbar's groups. -->
        <Style Selector="Border.divider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>

        <!-- The toolbar's menus, laid out like macOS System Settings: a title, then rounded cards of rows
             (label on the left, control on the right), with small headings above and notes below. -->
        <Style Selector="FlyoutPresenter.menu">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="StackPanel.menu">
            <Setter Property="Width" Value="360" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="StackPanel.menu > TextBlock.title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="4,0,0,4" />
        </Style>
        <Style Selector="StackPanel.menu > TextBlock.heading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="12,10,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="StackPanel.menu > TextBlock.note">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>
        <Style Selector="Border.separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="12,0,8,0" />
        </Style>
        <Style Selector="Grid.row > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.row ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,-8,0" />
        </Style>
        <Style Selector="Grid.row ComboBox">
            <Setter Property="MaxWidth" Value="210" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.step">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.page">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button.reset:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.reset">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A whole row that does something when clicked (the card is its background). -->
        <Style Selector="Button.row">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.value">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Themes that recolor the controls: mark the selected list item with a bar, since an
             accent-colored fill would hide its text. -->
        <Style Selector="Window.recolored ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
        </Style>
        <Style Selector="ListBox.byArtist Panel.artist">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WrapPanel.buttons > Button">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="core:SongInfo" x:DataType="core:SongInfo">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <!-- Hidden under an artist heading, which already says it. -->
                <Panel Classes="artist">
                    <TextBlock Text="{Binding Artist}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="local:GroupHeader" x:DataType="local:GroupHeader">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,2">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <!-- In stage mode the body spans both rows, so the toolbar floats over the chart instead of pushing it down. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Border x:Name="Toolbar" Grid.Row="0" ZIndex="1" Padding="12,6"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="SidebarToggle" Content="Songs" Click="OnSidebarToggleClick" ToolTip.Tip="Show or hide the song list" />
                        <Button Content="Open…" Click="OnOpenClick" ToolTip.Tip="Open a song file" />
                    </StackPanel>
                    <Border Classes="divider" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="ScrollToggle" Content="▶ Scroll" Click="OnScrollToggleClick" ToolTip.Tip="Start or stop (Space)" />
                        <Button x:Name="ScrollButton" Content="Manual ▾" ToolTip.Tip="How this song scrolls: by hand, timed, musically or following you">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu">
                                    <StackPanel Classes="menu">
                                        <TextBlock Classes="title" Text="Scrolling" />
                                        <Border Classes="card">
                                            <StackPanel>
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Mode" />
                                                    <ComboBox x:Name="ScrollModeBox" Grid.Column="1" SelectionChanged="OnScrollModeChanged"
                                                              ToolTip.Tip="How this song scrolls (remembered per song)">
                                                        <ComboBoxItem Content="Manual" ToolTip.Tip="Tap, swipe, keys or foot pedal" />
                                                        <ComboBoxItem Content="Timed" ToolTip.Tip="Paced by {duration} or {x_time} markers" />
                                                        <ComboBoxItem Content="Musical" ToolTip.Tip="Paced by tempo and bars, line by line" />
                                                        <ComboBoxItem Content="Follow audio (beta)" ToolTip.Tip="Listens to you play and follows your tempo (experimental)" />
                                                        <ComboBoxItem Content="Follow voice (beta)" ToolTip.Tip="Listens to you sing and keeps your place by the lyrics (experimental; recognition runs on this computer)" />
                                                    </ComboBox>
                                                </Grid>
                                                <Border Classes="separator" IsVisible="{Binding #SpeedRow.IsVisible}" />
                                                <Grid x:Name="SpeedRow" Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding #SpeedText.IsVisible}">
                                                    <TextBlock x:Name="SpeedLabel" Text="Speed" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <TextBlock x:Name="SpeedText" Text="1.0×" MinWidth="64" TextAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <Button x:Name="SlowerButton" Classes="step" Content="−" Click="OnScrollSlowerClick" />
                                                        <Button x:Name="FasterButton" Classes="step" Content="+" Click="OnScrollFasterClick" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Classes="separator" IsVisible="{Binding #TapTempoButton.IsVisible}" />
                                                <Button x:Name="TapTempoButton" Classes="row" Click="OnTapTempoClick"
                                                        ToolTip.Tip="Tap along with the beat to set the tempo (remembered for this song)">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="Tap tempo" />
                                                        <TextBlock Grid.Column="1" Classes="muted" Text="♩" />
                                                    </Grid>
                                                </Button>
                                                <Border Classes="separator" IsVisible="{Binding #TrainVoiceButton.IsVisible}" />
                                                <Button x:Name="TrainVoiceButton" Classes="row" Click="OnTrainVoiceClick" IsVisible="False"
                                                        ToolTip.Tip="Train Follow voice to your voice and microphone: sing this song once and it finds the settings that follow you best">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="Train to my voice…" />
                                                        <TextBlock Grid.Column="1" Classes="muted" Text="›" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="Space starts and stops. Page Up and Page Down, the arrow keys or a click at the top or bottom of the song turn pages." />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="PageUpButton" Classes="page" Content="▲" Click="OnPageUpClick" ToolTip.Tip="Page up (Page Up, Shift+Space, or click the top of the song)" />
                        <Button x:Name="PageDownButton" Classes="page" Content="▼" Click="OnPageDownClick" ToolTip.Tip="Page down (Page Down, Space, or click the bottom of the song)" />
                    </StackPanel>
                    <Border Classes="divider" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SongButton" IsEnabled="False" ToolTip.Tip="Transpose, capo, My key and notes for this song">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Song" />
                                <TextBlock x:Name="ShownKeyText" Classes="muted" />
                                <TextBlock Text="▾" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu" Opening="OnSongMenuOpening" Closed="OnStageNotesClosed">
                                    <StackPanel Classes="menu">
                                        <TextBlock Classes="title" Text="This song" />
                                        <Border Classes="card">
                                            <StackPanel>
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Transpose" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button x:Name="TransposeResetButton" Classes="reset" Content="0" IsEnabled="False"
                                                                Click="OnTransposeResetClick" ToolTip.Tip="Back to the original key" />
                                                        <Button Classes="step" Content="−" Click="OnTransposeDownClick" ToolTip.Tip="Transpose down a semitone" />
                                                        <Button Classes="step" Content="+" Click="OnTransposeUpClick" ToolTip.Tip="Transpose up a semitone" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Classes="separator" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Capo" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button x:Name="CapoResetButton" Classes="reset" Content="0" IsEnabled="False"
                                                                Click="OnCapoResetClick" ToolTip.Tip="Back to the song's capo" />
                                                        <Button Classes="step" Content="−" Click="OnCapoDownClick" ToolTip.Tip="Capo one fret lower" />
                                                        <Button Classes="step" Content="+" Click="OnCapoUpClick" ToolTip.Tip="Capo one fret higher (chords change, pitch stays)" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Classes="separator" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="My key" />
                                                    <ToggleSwitch x:Name="FitsVoiceToggle" Grid.Column="1" Click="OnFitsVoiceClick"
                                                                  ToolTip.Tip="This song, in the key shown, sits well for my voice. Suggest a set learns your range from these (and from songs you've transposed)." />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="note" Text="My key: this key sits well for your voice. Suggest a set learns your range from it." />
                                        <TextBlock Classes="heading" Text="EASIEST CAPO POSITIONS" />
                                        <Border Classes="card">
                                            <StackPanel x:Name="CapoSuggestions" />
                                        </Border>
                                        <TextBlock Classes="note" Text="The song sounds the same with each." />
                                        <TextBlock Classes="heading" Text="NOTES" />
                                        <TextBox x:Name="StageNotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                                 Watermark="Drop the 2nd verse · Long intro · Watch the key change" />
                                        <TextBlock Classes="note" Text="Shown above the song here and on the iPad; not saved in the song file." />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ViewButton" Content="View ▾" ToolTip.Tip="Chords, diagrams, text size and theme">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="menu" Opening="OnThemeFlyoutOpening">
                                    <StackPanel Classes="menu">
                                        <TextBlock Classes="title" Text="View" />
                                        <Border Classes="card">
                                            <StackPanel>
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Text size" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Classes="step" Content="A−" Click="OnZoomOutClick" ToolTip.Tip="Smaller text" />
                                                        <Button Classes="step" Content="A+" Click="OnZoomInClick" ToolTip.Tip="Larger text" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="heading" Text="CHORDS" />
                                        <Border Classes="card">
                                            <StackPanel>
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Show chords" />
                                                    <ToggleSwitch x:Name="ShowChordsCheck" Grid.Column="1" IsCheckedChanged="OnViewOptionChanged" />
                                                </Grid>
                                                <Border Classes="separator" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Chord diagrams" />
                                                    <ToggleSwitch x:Name="ShowDiagramsCheck" Grid.Column="1" IsCheckedChanged="OnViewOptionChanged" />
                                                </Grid>
                                                <Border Classes="separator" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto" ToolTip.Tip="Show chords as Nashville numbers in their key (5⁷ for G7 in C), so the song can be called in any key. Click one to see its chord.">
                                                    <TextBlock Text="Chord numbers (1 4 5)" />
                                                    <ToggleSwitch x:Name="ChordNumbersCheck" Grid.Column="1" IsCheckedChanged="OnViewOptionChanged" />
                                                </Grid>
                                                <Border Classes="separator" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto" ToolTip.Tip="Show simpler chords: Cmaj9 → C, Am7 → Am, G/B → G, F#m7b5 → F#m">
                                                    <TextBlock Text="Easy chords" />
                                                    <ToggleSwitch x:Name="SimplifyChordsCheck" Grid.Column="1" IsCheckedChanged="OnViewOptionChanged" />
                                                </Grid>
                                                <Border Classes="separator" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto" ToolTip.Tip="Dulcimer and Merlin diagrams use their diatonic frets (with 6+), written as tab: 0-1-3">
                                                    <TextBlock Text="Diagrams for" />
                                                    <ComboBox x:Name="InstrumentBox" Grid.Column="1" SelectionChanged="OnViewOptionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="SongTuningLabel" Classes="heading" Text="THIS SONG'S TUNING" />
                                        <Border Classes="card" IsVisible="{Binding #SongTuningLabel.IsVisible}">
                                            <StackPanel>
                                                <Grid Classes="row" ColumnDefinitions="*,Auto" IsVisible="{Binding #SongTuningBox.IsVisible}"
                                                      ToolTip.Tip="A tuning for this song only (a song can also give one with {meta: tuning Drop D})">
                                                    <TextBlock Text="Tuning" />
                                                    <ComboBox x:Name="SongTuningBox" Grid.Column="1" SelectionChanged="OnSongTuningChanged" />
                                                </Grid>
                                                <Border Classes="separator" IsVisible="{Binding #SongTuningBox.IsVisible}" />
                                                <Grid Classes="row" ColumnDefinitions="*,Auto" ToolTip.Tip="Tuned down for this song: the chords are fingered as written, and the tuner targets the lower strings">
                                                    <TextBlock Text="Pitch" />
                                                    <ComboBox x:Name="SongPitchBox" Grid.Column="1" SelectionChanged="OnSongTuningChanged">
                                                        <ComboBoxItem Content="Standard" />
                                                        <ComboBoxItem Content="Half step down" />
                                                        <ComboBoxItem Content="Whole step down" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Classes="heading" Text="THEME" />
                                        <Border Classes="card">
                                            <StackPanel x:Name="ThemeMenu" Margin="12,8" Spacing="2" />
                                        </Border>
                                        <TextBlock Classes="heading" Text="LIBRARY" />
                                        <Border Classes="card">
                                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Song keys include the capo" />
                                                <ToggleSwitch x:Name="KeyIncludesCapoCheck" Grid.Column="1" IsCheckedChanged="OnViewOptionChanged" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Classes="note" Text="On when {key} is the key you hear with the capo on, as LivePrompter charts are written. Off follows ChordPro: the key of the chords as written." />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Name="EditToggle" Content="Edit" Click="OnEditToggleClick" ToolTip.Tip="Edit the song's text, with a live preview (⌘/Ctrl+E)" />
                    <Button Content="Tuner" Click="OnTunerClick" ToolTip.Tip="Tune your instrument with the microphone (⌘/Ctrl+T)" />
                    <Button Content="PDF…" Click="OnExportPdfClick" ToolTip.Tip="Save as PDF to print or share" />
                    <ToggleButton x:Name="StageToggle" Content="Stage" Click="OnStageToggleClick" ToolTip.Tip="Full screen, large text, two columns (Esc to exit)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- What just happened (saved, reloaded…) and, while scrolling, where the song is. -->
        <Border x:Name="StatusBar" Grid.Row="2" Padding="12,3" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock x:Name="StatusText" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>

        <DockPanel x:Name="Body" Grid.Row="1">
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="280"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TabControl Padding="10,4,10,10">
                <TabItem Header="Library" FontSize="15">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,6,Auto">
                                <Button Content="New song…" Click="OnNewSongClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        ToolTip.Tip="Start a new song in the library, ready to write (⌘/Ctrl+N)" />
                                <Button Grid.Column="2" Content="⋯" ToolTip.Tip="Library folder, refresh and check">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Choose library folder…" Click="OnChooseFolderClick" />
                                            <MenuItem Header="Refresh" Click="OnRefreshLibraryClick" />
                                            <Separator />
                                            <MenuItem Header="Check the library…" Click="OnCheckLibraryClick"
                                                      ToolTip.Tip="Look for problems in the songs and setlists: empty headings, wrong keys, misspelled chords, missing songs" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="LibraryFolderText" Classes="label" FontSize="12" TextTrimming="LeadingCharacterEllipsis" />
                            <TextBox x:Name="SearchBox" Watermark="Search title, artist…" TextChanged="OnSearchChanged" />
                            <ComboBox x:Name="GroupByCombo" HorizontalAlignment="Stretch" SelectionChanged="OnGroupByChanged">
                                <ComboBoxItem Content="No grouping" />
                                <ComboBoxItem Content="Group by artist" />
                                <ComboBoxItem Content="Group by book" />
                                <ComboBoxItem Content="Recently added" />
                                <ComboBoxItem Content="Group by decade" />
                            </ComboBox>
                            <Grid ColumnDefinitions="*,6,*">
                                <ComboBox x:Name="KeyFilterCombo" HorizontalAlignment="Stretch" SelectionChanged="OnLibraryFilterChanged"
                                          ToolTip.Tip="Show only songs in this key (the key you hear, with the capo on)" />
                                <ComboBox x:Name="CapoFilterCombo" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="OnLibraryFilterChanged"
                                          ToolTip.Tip="Show only songs played with this capo" />
                            </Grid>
                            <!-- For dulcimers and the Merlin, whose frets leave some chords out. -->
                            <ComboBox x:Name="FitFilterCombo" HorizontalAlignment="Stretch" SelectionChanged="OnLibraryFilterChanged" IsVisible="False"
                                      ToolTip.Tip="Show only songs whose chords all have a fingering on your instrument (as the song is now, or after transposing)" />
                        </StackPanel>
                        <!-- SyncListSelections scrolls to the open song itself, except while a group is opened. -->
                        <ListBox x:Name="LibraryList" AutoScrollToSelectedItem="False" SelectionChanged="OnSongListSelectionChanged" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Recent" FontSize="15">
                    <ListBox x:Name="RecentList" SelectionChanged="OnSongListSelectionChanged" />
                </TabItem>

                <TabItem Header="Setlist" FontSize="15">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <ComboBox x:Name="LibrarySetlistsCombo" PlaceholderText="Setlists in your library…" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnLibrarySetlistChosen" />
                            <Grid ColumnDefinitions="*,6,Auto">
                                <TextBlock x:Name="SetlistNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="⋯" ToolTip.Tip="New, open, save and print setlists">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="New setlist" Click="OnNewSetlistClick" />
                                            <MenuItem Header="Open…" Click="OnOpenSetlistClick" />
                                            <MenuItem Header="Save as…" Click="OnSaveSetlistClick" />
                                            <Separator />
                                            <MenuItem Header="Print as PDF…" Click="OnSetlistPdfClick"
                                                      ToolTip.Tip="The whole setlist as one PDF to print: a list of the songs with key, capo and tempo, then every song" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="*,6,*,6,Auto,6,Auto">
                                <Button Content="+ Add song" Click="OnAddToSetlistClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Add the open song" />
                                <Button Grid.Column="2" Content="Remove" Click="OnRemoveFromSetlistClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Remove the selected song" />
                                <Button Grid.Column="4" Content="↑" Click="OnMoveUpClick" ToolTip.Tip="Move up" />
                                <Button Grid.Column="6" Content="↓" Click="OnMoveDownClick" ToolTip.Tip="Move down" />
                            </Grid>
                            <Button Content="Suggest a set…" Click="OnSuggestSetlistClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Build a set that flows (keys, tempos, capo) around the songs in this setlist, or see how this one flows" />
                        </StackPanel>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                            <Button Grid.Column="0" Content="◀ Previous" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnPreviousSongClick" ToolTip.Tip="Previous song (←)" />
                            <Button Grid.Column="2" Content="Next ▶" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnNextSongClick" ToolTip.Tip="Next song (→)" />
                        </Grid>
                        <ListBox x:Name="SetlistList" SelectionChanged="OnSongListSelectionChanged" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- The song's text, editable, beside a live preview of it. -->
        <Border x:Name="EditorPane" DockPanel.Dock="Right" Width="460" IsVisible="False"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel Margin="10,8,10,10">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="EditorTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="InsertButton" Content="Insert ▾" ToolTip.Tip="Insert a section around the selected lines, or a chorus repeat or comment at the cursor">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Verse" Tag="verse" Click="OnInsertSectionClick" />
                                        <MenuItem Header="Chorus" Tag="chorus" Click="OnInsertSectionClick" />
                                        <MenuItem Header="Bridge" Tag="bridge" Click="OnInsertSectionClick" />
                                        <MenuItem Header="Intro" Tag="intro" Click="OnInsertSectionClick" />
                                        <MenuItem Header="Outro" Tag="outro" Click="OnInsertSectionClick" />
                                        <MenuItem Header="Solo" Tag="solo" Click="OnInsertSectionClick" />
                                        <MenuItem Header="Instrumental" Tag="instrumental" Click="OnInsertSectionClick" />
                                        <Separator />
                                        <MenuItem Header="Repeat the chorus  {chorus}" Tag="{}{chorus}" Click="OnInsertLineClick" />
                                        <MenuItem Header="Repeat count  {comment: Repeat 2x}" Tag="{}{comment: Repeat 2x}" Click="OnInsertLineClick" />
                                        <MenuItem Header="Comment  {comment: …}" Tag="{}{comment: }" Click="OnInsertLineClick" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="SaveButton" Content="Save" Classes="accent" Click="OnSaveEditsClick" ToolTip.Tip="Save the file (⌘/Ctrl+S)" />
                            <Button x:Name="RevertButton" Content="Revert" Click="OnRevertEditsClick" ToolTip.Tip="Throw away changes since the last save" />
                            <Button Content="Save As…" Click="OnSaveAsNewSongClick"
                                    ToolTip.Tip="Save a copy as a new song: another title, artist or key (a new key moves the chords)" />
                            <Button Content="Done" Click="OnEditToggleClick" ToolTip.Tip="Close the editor" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="label" FontSize="12" Text="Insert a chord at the cursor" />
                    <WrapPanel x:Name="ChordButtons" Classes="buttons" />
                    <Grid ColumnDefinitions="*,6,Auto">
                        <TextBox x:Name="ChordEntry" Watermark="Another chord, e.g. Cadd9" KeyDown="OnChordEntryKeyDown" />
                        <Button Grid.Column="2" Content="Insert" Click="OnInsertChordClick" />
                    </Grid>
                    <!-- The key companion: the chords of the key in force at the cursor. -->
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="KeyCompanionTitle" Classes="label" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox x:Name="KeyChangeBox" Grid.Column="1" PlaceholderText="Change key here…" MinWidth="150"
                                      SelectionChanged="OnKeyChangeSelected"
                                      ToolTip.Tip="Insert a {key} at the cursor: the song changes key from there on" />
                        </Grid>
                        <WrapPanel x:Name="KeyTriads" Classes="buttons" />
                        <WrapPanel x:Name="KeySevenths" Classes="buttons" />
                        <WrapPanel x:Name="KeyBorrowed" Classes="buttons" />
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="EditorBox" AcceptsReturn="True" TextWrapping="NoWrap" FontSize="14"
                         FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="OnEditorTextChanged" />
            </DockPanel>
        </Border>

        <DockPanel>
            <!-- In stage mode, the next song in the setlist (tap to go to it) and a way back, in a strip of their own
                 below the chart so they never cover the words. -->
            <Panel x:Name="StageFooter" DockPanel.Dock="Bottom" IsVisible="False" Margin="28,6,28,10">
                <Button x:Name="NextSongBadge" IsVisible="False" Click="OnNextSongClick"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="14,8" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                        ToolTip.Tip="Go to the next song (→ key or foot pedal)">
                    <TextBlock x:Name="NextSongText" FontSize="18" />
                </Button>
                <Button x:Name="PreviousSongBadge" IsVisible="False" Click="OnPreviousSongClick"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Padding="12,8" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                        ToolTip.Tip="Back to the previous song (← key)">
                    <TextBlock x:Name="PreviousSongText" FontSize="16" Text="‹ Back" />
                </Button>
            </Panel>
        <Panel>
            <ScrollViewer x:Name="SongScroller"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="SongHost" Padding="32,24" />
            </ScrollViewer>
            <!-- Marks where the line being played is kept while scrolling follows the song. -->
            <Border x:Name="ReadingMarker" IsVisible="False" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="6" CornerRadius="3" Margin="12,0,0,0" />
            <!-- In stage mode the toolbar hides; this brings it back (for touch, where there's no mouse to move to the top). -->
            <Button x:Name="StageToolbarHandle" IsVisible="False" Click="OnStageToolbarHandleClick"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Opacity="0.55"
                    Padding="14,2" CornerRadius="0,0,8,8" FontSize="12" Content="▾ Controls"
                    ToolTip.Tip="Show the toolbar (or move the mouse to the top edge)" />
        </Panel>
        </DockPanel>
        </DockPanel>
    </Grid>
</Window>
