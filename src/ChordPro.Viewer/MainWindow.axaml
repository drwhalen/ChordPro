<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:ChordPro.Core"
        xmlns:local="using:ChordPro.Viewer"
        x:Class="ChordPro.Viewer.MainWindow"
        Title="ChordPro Viewer"
        Icon="/Assets/AppIcon.png"
        Width="1100" Height="900"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <Style Selector="WrapPanel.toolbar > StackPanel">
            <Setter Property="Margin" Value="0,3,18,3" />
        </Style>
        <Style Selector="WrapPanel.toolbar > StackPanel > :is(Control)">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.value">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Themes that recolor the controls: mark the selected list item with a bar, since an
             accent-colored fill would hide its text. -->
        <Style Selector="Window.recolored ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="BorderThickness" Value="4,0,0,0" />
        </Style>
        <Style Selector="ListBox.byArtist Panel.artist">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WrapPanel.buttons > Button">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <DataTemplate DataType="core:SongInfo" x:DataType="core:SongInfo">
            <StackPanel Margin="0,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <!-- Hidden under an artist heading, which already says it. -->
                <Panel Classes="artist">
                    <TextBlock Text="{Binding Artist}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="local:GroupHeader" x:DataType="local:GroupHeader">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,2">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" Opacity="0.6" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <!-- In stage mode the body spans both rows, so the toolbar floats over the chart instead of pushing it down. -->
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="Toolbar" Grid.Row="0" ZIndex="1" Padding="12,5"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <WrapPanel Classes="toolbar">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton x:Name="SidebarToggle" Content="Songs" Click="OnSidebarToggleClick" ToolTip.Tip="Show or hide the song list" />
                    <Button Content="Open…" Click="OnOpenClick" />
                    <Button Content="PDF…" Click="OnExportPdfClick" ToolTip.Tip="Save as PDF to print or share" />
                    <ToggleButton x:Name="EditToggle" Content="Edit" Click="OnEditToggleClick" ToolTip.Tip="Edit the song's text, with a live preview (⌘/Ctrl+E)" />
                    <Button Content="Tuner" Click="OnTunerClick" ToolTip.Tip="Tune your instrument with the microphone (⌘/Ctrl+T)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="A−" Click="OnZoomOutClick" ToolTip.Tip="Smaller text" />
                    <Button Content="A+" Click="OnZoomInClick" ToolTip.Tip="Larger text" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="Transpose" />
                    <Button Content="−" Click="OnTransposeDownClick" ToolTip.Tip="Transpose down a semitone" />
                    <Button x:Name="TransposeResetButton" Classes="value" Content="0" IsEnabled="False"
                            Click="OnTransposeResetClick" ToolTip.Tip="Reset to original key" />
                    <Button Content="+" Click="OnTransposeUpClick" ToolTip.Tip="Transpose up a semitone" />
                    <ToggleButton x:Name="FitsVoiceToggle" Content="My key" Click="OnFitsVoiceClick"
                                  ToolTip.Tip="This song, in the key shown, sits well for my voice. Suggest a set learns your range from these (and from songs you've transposed)." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="label" Text="Capo" />
                    <Button Content="−" Click="OnCapoDownClick" ToolTip.Tip="Capo one fret lower" />
                    <Button x:Name="CapoResetButton" Classes="value" Content="0" IsEnabled="False"
                            Click="OnCapoResetClick" ToolTip.Tip="Reset to the song's capo" />
                    <Button Content="+" Click="OnCapoUpClick" ToolTip.Tip="Capo one fret higher (chords change, pitch stays)" />
                    <Button x:Name="CapoSuggestButton" Content="Suggest…" ToolTip.Tip="Find the capo position with the easiest chords">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnCapoSuggestOpening">
                                <StackPanel x:Name="CapoSuggestions" Spacing="4" MinWidth="300" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="ScrollModeBox" MinWidth="120" SelectionChanged="OnScrollModeChanged"
                              ToolTip.Tip="How this song scrolls (remembered per song)">
                        <ComboBoxItem Content="Manual" ToolTip.Tip="Tap, swipe, keys or foot pedal" />
                        <ComboBoxItem Content="Timed" ToolTip.Tip="Paced by {duration} or {x_time} markers" />
                        <ComboBoxItem Content="Musical" ToolTip.Tip="Paced by tempo and bars, line by line" />
                        <ComboBoxItem Content="Follow audio (beta)" ToolTip.Tip="Listens to you play and follows your tempo (experimental)" />
                        <ComboBoxItem Content="Follow voice (beta)" ToolTip.Tip="Listens to you sing and keeps your place by the lyrics (experimental; recognition runs on this computer)" />
                    </ComboBox>
                    <ToggleButton x:Name="ScrollToggle" Content="▶ Scroll" Click="OnScrollToggleClick" ToolTip.Tip="Start or stop (Space)" />
                    <Button x:Name="SlowerButton" Content="−" Click="OnScrollSlowerClick" />
                    <TextBlock x:Name="SpeedText" Text="1.0×" MinWidth="34" TextAlignment="Center" />
                    <Button x:Name="FasterButton" Content="+" Click="OnScrollFasterClick" />
                    <Button x:Name="TrainVoiceButton" Content="Train…" Click="OnTrainVoiceClick" IsVisible="False"
                            ToolTip.Tip="Train Follow voice to your voice and microphone: sing this song once and it finds the settings that follow you best" />
                    <Button x:Name="TapTempoButton" Content="Tap" Click="OnTapTempoClick"
                            ToolTip.Tip="Tap along with the beat to set the tempo (remembered for this song)" />
                    <Button x:Name="PageUpButton" Content="▲" Click="OnPageUpClick" ToolTip.Tip="Page up (Page Up, Shift+Space, or tap the top of the song)" />
                    <Button x:Name="PageDownButton" Content="▼" Click="OnPageDownClick" ToolTip.Tip="Page down (Page Down, Space, or tap the bottom of the song)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="View ▾">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="6" MinWidth="180">
                                    <CheckBox x:Name="ShowChordsCheck" Content="Show chords" IsCheckedChanged="OnViewOptionChanged" />
                                    <CheckBox x:Name="ShowDiagramsCheck" Content="Chord diagrams" IsCheckedChanged="OnViewOptionChanged" />
                                <CheckBox x:Name="SimplifyChordsCheck" Content="Easy chords" IsCheckedChanged="OnViewOptionChanged"
                                          ToolTip.Tip="Show simpler chords: Cmaj9 → C, Am7 → Am, G/B → G, F#m7b5 → F#m" />
                                    <CheckBox x:Name="KeyIncludesCapoCheck" Content="Song keys include the capo" IsCheckedChanged="OnViewOptionChanged"
                                              ToolTip.Tip="Turn on when {key} is the key you hear with the capo on, as LivePrompter charts are written. Off follows ChordPro: {key} is the key of the chords as written." />
                                    <TextBlock Classes="label" Text="Diagrams for" Margin="0,6,0,0" />
                                    <RadioButton x:Name="GuitarRadio" GroupName="Instrument" Content="Guitar" IsCheckedChanged="OnViewOptionChanged" />
                                    <RadioButton x:Name="UkuleleRadio" GroupName="Instrument" Content="Ukulele" IsCheckedChanged="OnViewOptionChanged" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ThemeButton" Content="Theme ▾" ToolTip.Tip="Day, night, high-contrast and your own themes">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnThemeFlyoutOpening">
                                <StackPanel x:Name="ThemeMenu" Spacing="4" MinWidth="240" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton x:Name="StageToggle" Content="Stage" Click="OnStageToggleClick" ToolTip.Tip="Full screen, large text, two columns (Esc to exit)" />
                    <TextBlock x:Name="StatusText" Classes="label" Margin="6,3,0,3" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <DockPanel x:Name="Body" Grid.Row="1">
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="280"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TabControl Padding="10,4,10,10">
                <TabItem Header="Library" FontSize="15">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <WrapPanel Classes="buttons">
                                <Button Content="Choose folder…" Click="OnChooseFolderClick" />
                                <Button Content="Refresh" Click="OnRefreshLibraryClick" />
                                <Button Content="Check…" Click="OnCheckLibraryClick"
                                        ToolTip.Tip="Look for problems in the songs and setlists: empty headings, wrong keys, misspelled chords, missing songs" />
                            </WrapPanel>
                            <TextBlock x:Name="LibraryFolderText" Classes="label" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="SearchBox" Watermark="Search title, artist…" TextChanged="OnSearchChanged" />
                            <ComboBox x:Name="GroupByCombo" HorizontalAlignment="Stretch" SelectionChanged="OnGroupByChanged">
                                <ComboBoxItem Content="No grouping" />
                                <ComboBoxItem Content="Group by artist" />
                                <ComboBoxItem Content="Group by book" />
                                <ComboBoxItem Content="Recently added" />
                            </ComboBox>
                            <Grid ColumnDefinitions="*,6,*">
                                <ComboBox x:Name="KeyFilterCombo" HorizontalAlignment="Stretch" SelectionChanged="OnLibraryFilterChanged"
                                          ToolTip.Tip="Show only songs in this key (the key you hear, with the capo on)" />
                                <ComboBox x:Name="CapoFilterCombo" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="OnLibraryFilterChanged"
                                          ToolTip.Tip="Show only songs played with this capo" />
                            </Grid>
                        </StackPanel>
                        <!-- SyncListSelections scrolls to the open song itself, except while a group is opened. -->
                        <ListBox x:Name="LibraryList" AutoScrollToSelectedItem="False" SelectionChanged="OnSongListSelectionChanged" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Recent" FontSize="15">
                    <ListBox x:Name="RecentList" SelectionChanged="OnSongListSelectionChanged" />
                </TabItem>

                <TabItem Header="Setlist" FontSize="15">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <ComboBox x:Name="LibrarySetlistsCombo" PlaceholderText="Setlists in your library…" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnLibrarySetlistChosen" />
                            <TextBlock x:Name="SetlistNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <WrapPanel Classes="buttons">
                                <Button Content="New" Click="OnNewSetlistClick" />
                                <Button Content="Open…" Click="OnOpenSetlistClick" />
                                <Button Content="Save as…" Click="OnSaveSetlistClick" />
                                <Button Content="PDF…" Click="OnSetlistPdfClick" ToolTip.Tip="The whole setlist as one PDF to print: a list of the songs with key, capo and tempo, then every song" />
                            </WrapPanel>
                            <WrapPanel Classes="buttons">
                                <Button Content="+ Add" Click="OnAddToSetlistClick" ToolTip.Tip="Add the open song" />
                                <Button Content="Remove" Click="OnRemoveFromSetlistClick" />
                                <Button Content="↑" Click="OnMoveUpClick" ToolTip.Tip="Move up" />
                                <Button Content="↓" Click="OnMoveDownClick" ToolTip.Tip="Move down" />
                            </WrapPanel>
                            <Button Content="Suggest a set…" Click="OnSuggestSetlistClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Build a set that flows (keys, tempos, capo) around the songs in this setlist, or see how this one flows" />
                        </StackPanel>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                            <Button Grid.Column="0" Content="◀ Previous" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnPreviousSongClick" ToolTip.Tip="Previous song (←)" />
                            <Button Grid.Column="2" Content="Next ▶" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Click="OnNextSongClick" ToolTip.Tip="Next song (→)" />
                        </Grid>
                        <ListBox x:Name="SetlistList" SelectionChanged="OnSongListSelectionChanged" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- The song's text, editable, beside a live preview of it. -->
        <Border x:Name="EditorPane" DockPanel.Dock="Right" Width="460" IsVisible="False"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel Margin="10,8,10,10">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="EditorTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SaveButton" Content="Save" Classes="accent" Click="OnSaveEditsClick" ToolTip.Tip="Save the file (⌘/Ctrl+S)" />
                            <Button x:Name="RevertButton" Content="Revert" Click="OnRevertEditsClick" ToolTip.Tip="Throw away changes since the last save" />
                            <Button Content="Done" Click="OnEditToggleClick" ToolTip.Tip="Close the editor" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="label" FontSize="12" Text="Insert a chord at the cursor" />
                    <WrapPanel x:Name="ChordButtons" Classes="buttons" />
                    <Grid ColumnDefinitions="*,6,Auto">
                        <TextBox x:Name="ChordEntry" Watermark="Another chord, e.g. Cadd9" KeyDown="OnChordEntryKeyDown" />
                        <Button Grid.Column="2" Content="Insert" Click="OnInsertChordClick" />
                    </Grid>
                </StackPanel>
                <TextBox x:Name="EditorBox" AcceptsReturn="True" TextWrapping="NoWrap" FontSize="14"
                         FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextChanged="OnEditorTextChanged" />
            </DockPanel>
        </Border>

        <Panel>
            <ScrollViewer x:Name="SongScroller"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="SongHost" Padding="32,24" />
            </ScrollViewer>
            <!-- Marks where the line being played is kept while scrolling follows the song. -->
            <Border x:Name="ReadingMarker" IsVisible="False" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="6" CornerRadius="3" Margin="12,0,0,0" />
            <!-- In stage mode the toolbar hides; this brings it back (for touch, where there's no mouse to move to the top). -->
            <Button x:Name="StageToolbarHandle" IsVisible="False" Click="OnStageToolbarHandleClick"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Opacity="0.55"
                    Padding="14,2" CornerRadius="0,0,8,8" FontSize="12" Content="▾ Controls"
                    ToolTip.Tip="Show the toolbar (or move the mouse to the top edge)" />
            <!-- In stage mode, the next song in the setlist (tap to go to it) and a way back. -->
            <Button x:Name="NextSongBadge" IsVisible="False" Click="OnNextSongClick"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16"
                    Padding="14,8" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                    ToolTip.Tip="Go to the next song (→ key or foot pedal)">
                <TextBlock x:Name="NextSongText" FontSize="18" />
            </Button>
            <Button x:Name="PreviousSongBadge" IsVisible="False" Click="OnPreviousSongClick"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,16"
                    Padding="12,8" CornerRadius="8" BorderThickness="1" Cursor="Hand"
                    ToolTip.Tip="Back to the previous song (← key)">
                <TextBlock x:Name="PreviousSongText" FontSize="16" Text="‹ Back" />
            </Button>
        </Panel>
        </DockPanel>
    </Grid>
</Window>
