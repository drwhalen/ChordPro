<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChordPro.Viewer.App"
             Name="ChordPro Viewer"
             RequestedThemeVariant="Default">
    <!-- The macOS application menu (replaces Avalonia's default "About Avalonia"). -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About ChordPro Viewer" Click="OnAboutClick" />
        </NativeMenu>
    </NativeMenu.Menu>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>
